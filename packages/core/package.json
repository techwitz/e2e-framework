{
  "name": "@open-test/playwright-core",
  "version": "1.0.0",
  "description": "Enterprise-grade, agnostic, open-source testing & performance engineering engine for Playwright",
  "license": "MIT",
  "author": "open-test contributors",
  "homepage": "https://github.com/techwitz/e2e-framework/tree/main/packages/core#readme",
  "repository": {

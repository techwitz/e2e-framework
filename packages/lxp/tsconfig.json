{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@open-test/playwright-core": ["../core/src/index.js"]
    }
  },
  "include": ["src/**/*", "smoke/**/*", "regression/**/*", "data-driven/**/*", "performance/**/*", "accessibility/**/*", "visual/**/*", "playwright.config.ts"]
}
